+// PutContent updates a file through its owner's normal upload path.
+func (s *SingleFileService) PutContent(c *gin.Context) (*explorer.FileResponse, error) {
+	dep := dependency.FromContext(c)
+	actor := inventory.UserFromContext(c)
+	adminManager := manager.NewFileManager(dep, actor)
+	defer adminManager.Recycle()
+	file, err := adminManager.TraverseFile(c, s.ID)
+	if ent.IsNotFound(err) {
+		return nil, serializer.NewError(serializer.CodeNotFound, "File not found", err)
+	}
+	if err != nil {
+		return nil, err
+	}
+	if file.Type() != types.FileTypeFile || file.IsSymbolic() {
+		return nil, serializer.NewError(serializer.CodeParamErr, "Only regular files can be edited", nil)
+	}
+
+	uri := file.Uri(false)
+	if uri == nil {
+		return nil, serializer.NewError(serializer.CodeNotFound, "File path not found", nil)
+	}
+	ownerCtx := context.WithValue(c, inventory.LoadUserGroup{}, true)
+	owner, err := dep.UserClient().GetByID(ownerCtx, file.OwnerID())
+	if ent.IsNotFound(err) {
+		return nil, serializer.NewError(serializer.CodeNotFound, "File owner not found", err)
+	}
+	if err != nil {
+		return nil, serializer.NewError(serializer.CodeDBError, "Failed to load file owner", err)
+	}
+
+	adminRequest := c.Request
+	defer func() { c.Request = adminRequest }()
+	// Elevation is confined to this administrator request; never persist group changes.
+	ownerCopy, groupCopy := *owner, *owner.Edges.Group
+	permissions := append(boolset.BooleanSet(nil), (*groupCopy.Permissions)...)
+	boolset.Set(types.GroupPermissionIsAdmin, true, &permissions)
+	groupCopy.Permissions = &permissions
+	ownerCopy.Edges.Group = &groupCopy
+	owner = &ownerCopy
+	util.WithValue(c, inventory.UserCtx{}, owner)
+	ownerManager := manager.NewFileManager(dep, owner)
+	defer ownerManager.Recycle()
+	lockSession, err := ownerManager.Lock(c, -1, owner, true, fs.LockApp(fs.ApplicationUpload), uri, "")
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = ownerManager.Unlock(c, lockSession.LastToken()) }()
+	current, err := ownerManager.Get(c, uri)
+	if err != nil || current == nil || current.ID() != s.ID {
+		return nil, serializer.NewError(serializer.CodeNotFound, "File path no longer matches ID", err)
+	}
+
+	previous := c.Query("previous")
+	if previous == "" {
+		previous = hashid.EncodeEntityID(dep.HashIDEncoder(), current.PrimaryEntityID())
+	}
+	update := &explorer.FileUpdateService{Uri: uri.String(), Previous: previous}
+	result, err := update.PutContent(c, lockSession)
+	if err == nil {
+		dep.Logger().Info("Admin content edit: actor=%d owner=%d file=%d", actor.ID, owner.ID, s.ID)
+	}
+	return result, err
+}
